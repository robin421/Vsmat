/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.google-analytics.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  CDN-Cache-Control: max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: max-age=0, must-revalidate
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: max-age=0, must-revalidate
  Content-Type: text/plain; charset=utf-8

/favicon.png
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: max-age=0, must-revalidate
  Content-Type: image/png

/icon.svg
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: max-age=0, must-revalidate
  Content-Type: image/svg+xml

/icon-192.png
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: max-age=0, must-revalidate
  Content-Type: image/png

/icon-512.png
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: max-age=0, must-revalidate
  Content-Type: image/png

/apple-touch-icon.png
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: max-age=0, must-revalidate
  Content-Type: image/png

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: max-age=0, must-revalidate
  Cloudflare-CDN-Cache-Control: max-age=0, must-revalidate
  Content-Type: application/manifest+json; charset=utf-8

/og-image.png
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: image/png

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/tesseract/*
  Cache-Control: public, max-age=31536000, immutable

/tessdata/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
